# CareerSignal AI - environment template. Copy to .env.local and fill in.
# NEVER commit real keys. All values are read server-side only.

# Which LLM provider to use: mock | gemini | groq
# "mock" needs no API key and runs deterministic, rule-based agents (demo mode).
LLM_PROVIDER=mock

# Google Gemini (https://aistudio.google.com/apikey). Free-tier quotas are limited and change.
# Run `npm run gemini:check` after filling this in.
GEMINI_API_KEY=
# Default: Google's moving alias for the newest Flash model. `npm run gemini:check`
# lists the models your key can use; pin one here if you want stable behaviour.
GEMINI_MODEL=gemini-flash-latest

# Groq (https://console.groq.com/keys). Free-tier rate limits apply.
GROQ_API_KEY=
# Verify the current model id in Groq's model list before use.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional per-agent model override (same provider only), e.g.:
# LLM_MODEL_CRITIC=<a model id listed by npm run gemini:check>

# Request timeout per LLM call in milliseconds.
LLM_TIMEOUT_MS=60000

# Where local workspace data is stored (JSON files, gitignored).
DATA_DIR=.data
